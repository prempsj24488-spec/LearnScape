const DRAG_ITEMS = [
  { id:'banana',  icon:'🍌', name:'Banana Peel',   hint:'Food waste',      type:'organic',   pts:10 },
  { id:'plastic', icon:'🧴', name:'Plastic Bottle', hint:'Single-use item', type:'plastic',   pts:10 },
  { id:'can',     icon:'🥫', name:'Metal Can',      hint:'Tin/Aluminium',   type:'metal',     pts:10 },
  { id:'paper',   icon:'📰', name:'Newspaper',      hint:'Dry waste',       type:'paper',     pts:10 },
  { id:'battery', icon:'🔋', name:'Old Battery',    hint:'Dangerous item',  type:'hazardous', pts:10 },
];

let dragScoreVal = 0;
let dragCombo = 1;
let dragCorrect = 0;
let dragMistakes = 0;
let draggedItemId = null;
const binCounts = { organic: 0, plastic: 0, metal: 0, paper: 0, hazardous: 0 };

function buildItemsGrid() {
  const grid = document.getElementById('drag-items-grid');
  grid.innerHTML = '';
  // Shuffle items
  const shuffled = [...DRAG_ITEMS].sort(() => Math.random() - 0.5);
  shuffled.forEach(item => {
    const el = document.createElement('div');
    el.className = 'drag-item';
    el.id = 'item-' + item.id;
    el.setAttribute('draggable', 'true');
    el.setAttribute('data-type', item.type);
    el.innerHTML = `
      <span class="drag-item-icon">${item.icon}</span>
      <div class="drag-item-info">
        <span class="drag-item-name">${item.name}</span>
        <span class="drag-item-hint">${item.hint}</span>
      </div>
      <span class="drag-item-pts">+${item.pts}pts</span>
    `;
    el.addEventListener('dragstart', (e) => handleDragStart(e, item.id));
    el.addEventListener('dragend', () => el.classList.remove('dragging'));
    grid.appendChild(el);
  });
}

function handleDragStart(e, id) {
  draggedItemId = id;
  setTimeout(() => {
    const el = document.getElementById('item-' + id);
    if(el) el.classList.add('dragging');
  }, 0);
}

function dragOver(e) {
  e.preventDefault();
  e.currentTarget.classList.add('drag-over');
}

function dragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

function dropItem(e, binType) {
  e.preventDefault();
  const bin = e.currentTarget;
  bin.classList.remove('drag-over');
  if(!draggedItemId) return;

  const item = document.getElementById('item-' + draggedItemId);
  if(!item || item.classList.contains('placed')) return;

  const itemType = item.getAttribute('data-type');
  const itemData = DRAG_ITEMS.find(i => i.id === draggedItemId);
  const pts = itemData ? itemData.pts : 10;

  if(itemType === binType) {
    // Correct!
    item.classList.add('placed', 'correct-flash');
    const bonusPts = pts * dragCombo;
    dragScoreVal += bonusPts;
    dragCombo = Math.min(dragCombo + 1, 5);
    dragCorrect++;
    binCounts[binType]++;

    const feedback = dragCombo > 2
      ? `🔥 COMBO x${dragCombo-1}! +${bonusPts} pts — ${itemData.name} goes in ${binType}!`
      : `✅ Correct! +${bonusPts} pts — ${itemData.name} goes in ${binType}!`;
    showFeedback(feedback, 'good');
    bin.classList.add('correct-bin');

    document.getElementById('count-' + binType).textContent = binCounts[binType];
    setTimeout(() => bin.classList.remove('correct-bin'), 800);
  } else {
    // Wrong!
    item.classList.add('wrong-flash');
    dragCombo = 1;
    dragMistakes++;
    const correctBinNames = { organic:'Organic', plastic:'Plastic', metal:'Metal', paper:'Paper', hazardous:'Hazardous' };
    showFeedback(`❌ Wrong bin! ${itemData ? itemData.name : 'This item'} goes in the ${correctBinNames[itemType]} bin!`, 'bad');
    bin.classList.add('wrong-bin');
    setTimeout(() => {
      bin.classList.remove('wrong-bin');
      item.classList.remove('wrong-flash');
    }, 600);
  }

  // Update HUD
  document.getElementById('drag-score-val').textContent = dragScoreVal;
  document.getElementById('drag-combo-val').textContent = 'x' + dragCombo;
  document.getElementById('drag-correct-val').textContent = dragCorrect + '/' + DRAG_ITEMS.length;
  document.getElementById('drag-mistakes-val').textContent = dragMistakes;

  draggedItemId = null;
}

function showFeedback(msg, type) {
  const fb = document.getElementById('drag-feedback');
  fb.textContent = msg;
  fb.className = 'feedback-strip ' + (type || '');
  clearTimeout(fb._timeout);
  fb._timeout = setTimeout(() => {
    fb.className = 'feedback-strip';
    fb.textContent = 'Keep going — drag more items!';
  }, 2500);
}

