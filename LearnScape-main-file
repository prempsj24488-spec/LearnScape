  font-weight: 900; font-size: 1.1rem; font-family: var(--font-head);
  min-width: 56px; text-align: center;
}
.timer.urgent { animation: timerUrgent 0.5s infinite; }
@keyframes timerUrgent {
  0%,100% { background: linear-gradient(135deg, #FF8A65, #f44336); }
  50%      { background: linear-gradient(135deg, #f44336, #FF8A65); transform: scale(1.06); }
}
.quiz-question { font-family: var(--font-head); font-size: 1.4rem; font-weight: 700; color: #2d4a35; margin-bottom: 28px; line-height: 1.4; }
.quiz-options { display: flex; flex-direction: column; gap: 14px; }
.quiz-option {
  width: 100%; padding: 18px 24px; border-radius: var(--radius-sm);
  border: 2.5px solid rgba(76,175,80,0.18); background: rgba(255,255,255,0.7);
  font-family: var(--font-body); font-size: 1.05rem; font-weight: 700; color: #2d4a35;
  cursor: pointer; text-align: left; transition: border-color 0.2s, background 0.2s, transform 0.2s;
}
.quiz-option:hover { border-color: var(--green-main); background: rgba(76,175,80,0.07); transform: scale(1.02); }
.quiz-option.correct { border-color: var(--green-main); background: rgba(76,175,80,0.18); animation: correctAnim 0.5s ease; }
@keyframes correctAnim { 0% { transform: scale(1); } 30% { transform: scale(1.06); } 100% { transform: scale(1); } }
.quiz-option.wrong { border-color: #f44336; background: rgba(244,67,54,0.09); animation: wrongAnim 0.4s ease; }
@keyframes wrongAnim {
  0%,100% { transform: translateX(0); }
  20%      { transform: translateX(-10px); }
  40%      { transform: translateX(10px); }
  60%      { transform: translateX(-7px); }
  80%      { transform: translateX(7px); }
}

