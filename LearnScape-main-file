function openHomePanel(){

    homeQuestionIndex = 0;

    document.getElementById("home-panel").style.display = "flex";

    loadHomeQuestion();

}

function closeHomePanel(){
    document.getElementById("home-panel").style.display = "none";
}

function restartLevel7(){

    document.getElementById("victory-overlay")
        .classList.remove("show");

    const video =
        document.getElementById("final-video");

    video.pause();
    video.currentTime = 0;
    video.style.display = "none";

    document.getElementById("level7-map").src =
        "assets-level7/level7_map_polluted.png";

    riverQuestionIndex = 0;
    homeQuestionIndex = 0;

    closeRiverPanel();
    closeHomePanel();
}


</script>

