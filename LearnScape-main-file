}
.quiz-card {
  background: var(--card-bg); backdrop-filter: blur(18px);
  border-radius: var(--radius); padding: 48px 52px; width: 100%; max-width: 620px;
  box-shadow: var(--shadow), 0 0 0 1.5px rgba(76,175,80,0.1); position: relative;
